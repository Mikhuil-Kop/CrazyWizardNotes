--- !u!1001 &983199747
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1677226505}
    m_Modifications:
    - target: {fileID: 1423541192035953609, guid: a52a5ea314bd247a398664ab13043dba, type: 3}
      propertyPath: m_Name
      value: TextItem
      objectReference: {fileID: 0}
    - target: {fileID: 2819813355704338953, guid: a52a5ea314bd247a398664ab13043dba, type: 3}
      propertyPath: m_text
      value: "\u0415\u0441\u0442\u044C \u043C\u043D\u043E\u0433\u043E \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432
        Lorem Ipsum, \u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
        \u0438\u0437 \u043D\u0438\u0445 \u0438\u043C\u0435\u0435\u0442 \u043D\u0435
        \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u0435\u043C\u043B\u0435\u043C\u044B\u0435
        \u043C\u043E\u0434\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
        \u044E\u043C\u043E\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0432\u0441\u0442\u0430\u0432\u043A\u0438 \u0438\u043B\u0438 \u0441\u043B\u043E\u0432\u0430,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0430\u0436\u0435 \u043E\u0442\u0434\u0430\u043B\u0451\u043D\u043D\u043E
        \u043D\u0435 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
        \u043B\u0430\u0442\u044B\u043D\u044C. \u0415\u0441\u043B\u0438 \u0432\u0430\u043C
        \u043D\u0443\u0436\u0435\u043D Lorem Ipsum \u0434\u043B\u044F \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0433\u043E
        \u043F\u0440\u043E\u0435\u043A\u0442\u0430, \u0432\u044B \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
        \u043D\u0435 \u0445\u043E\u0442\u0438\u0442\u0435 \u043A\u0430\u043A\u043E\u0439-\u043D\u0438\u0431\u0443\u0434\u044C
        \u0448\u0443\u0442\u043A\u0438, \u0441\u043A\u0440\u044B\u0442\u043E\u0439
        \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u0430\u0431\u0437\u0430\u0446\u0430.
        \u0422\u0430\u043A\u0436\u0435 \u0432\u0441\u0435 \u0434\u0440\u0443\u0433\u0438\u0435
        \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u044B
        Lorem Ipsum \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
        \u043E\u0434\u0438\u043D \u0438 \u0442\u043E\u0442 \u0436\u0435 \u0442\u0435\u043A\u0441\u0442,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
        \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0442, \u043F\u043E\u043A\u0430
        \u043D\u0435 \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0443\u0442 \u043D\u0443\u0436\u043D\u044B\u0439
        \u043E\u0431\u044A\u0451\u043C. "
      objectReference: {fileID: 0}
    - target: {fileID: 3091924075633843321, guid: a52a5ea314bd247a398664ab13043dba, type: 3}
      propertyPath: m_Pivot.x
      value: 0.5
